# Simula build/start nativos de Render en Linux; no publica imagen ni usa Cloud.
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY apps/backend/src/ apps/backend/src/
COPY apps/backend/scripts/ apps/backend/scripts/
COPY apps/backend/tsconfig*.json apps/backend/prisma.config.ts apps/backend/
COPY apps/backend/prisma/schema.prisma apps/backend/prisma/schema.prisma
COPY packages/shared/src/ packages/shared/src/
COPY packages/shared/tsconfig.json packages/shared/
ENV NODE_ENV=production HUSKY=0 \
    DATABASE_URL=postgresql://smoke:smoke@127.0.0.1:1/smoke?connect_timeout=1 \
    SUPABASE_URL=https://supabase.invalid \
    SUPABASE_ANON_KEY=smoke-not-a-secret \
    CORS_ORIGIN=https://turnosmart-demo.vercel.app
# Sin DIRECT_URL: generar no conecta ni requiere credenciales de migracion.
RUN npm run build:render
COPY infra/render/check-runtime.mjs /checks/check-runtime.mjs
RUN node /checks/check-runtime.mjs
ENV PORT=43129
EXPOSE 43129
CMD ["npm", "run", "start:render"]
