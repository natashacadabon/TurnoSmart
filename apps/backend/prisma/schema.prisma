generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProfileRole {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentConfirmationStatus {
  PENDING
  CONFIRMED
}

enum AppointmentPublicAction {
  CONFIRM
  CANCEL
  REQUEST_RESCHEDULE
}

enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  MARKED_NO_SHOW
  RESCHEDULE_REQUESTED
  RESCHEDULE_REQUEST_DISMISSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReminderChannel {
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum AppointmentEmailKind {
  BOOKED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  RESCHEDULE_DECLINED
  REMINDER_48H
  REMINDER_24H
  REMINDER
}

enum NotificationKind {
  APPOINTMENT_UPCOMING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  MARKED_NO_SHOW
  COMPLETED
  RESCHEDULE_REQUESTED
}

model Business {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String
  timezone                    String             @default("America/Argentina/Buenos_Aires")
  bookingEmailEnabled         Boolean            @default(true) @map("booking_email_enabled")
  confirmationEmailEnabled    Boolean            @default(true) @map("confirmation_email_enabled")
  remindersEnabled            Boolean            @default(true) @map("reminders_enabled")
  reminderHours               Int[]              @default([48, 24]) @map("reminder_hours")
  reminder24hEnabled          Boolean            @default(true) @map("reminder_24h_enabled")
  reminder48hEnabled          Boolean            @default(true) @map("reminder_48h_enabled")
  cancellationEmailEnabled    Boolean            @default(false) @map("cancellation_email_enabled")
  rescheduleEmailEnabled      Boolean            @default(false) @map("reschedule_email_enabled")
  customerCancellationEnabled Boolean            @default(true) @map("customer_cancellation_enabled")
  customerConfirmationEnabled Boolean            @default(true) @map("customer_confirmation_enabled")
  customerRescheduleEnabled   Boolean            @default(true) @map("customer_reschedule_enabled")
  cancellationMinimumHours    Int                @default(0) @map("cancellation_minimum_hours")
  rescheduleMinimumHours      Int                @default(0) @map("reschedule_minimum_hours")
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles                    Profile[]
  customers                   Customer[]
  services                    Service[]
  availabilityRules           AvailabilityRule[]
  appointments                Appointment[]
  appointmentEvents           AppointmentEvent[]
  riskScores                  RiskScore[]
  reminders                   Reminder[]
  notifications               Notification[]

  @@map("businesses")
}

model Profile {
  // Same UUID as auth.users.id. Creation is handled by trusted backend code.
  id                String             @id @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  email             String
  fullName          String?            @map("full_name")
  role              ProfileRole        @default(STAFF)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]

  @@unique([id, businessId])
  @@unique([businessId, email])
  @@index([businessId])
  @@map("profiles")
}

model Customer {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  fullName     String        @map("full_name")
  email        String?
  phone        String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([id, businessId])
  @@index([businessId, fullName])
  @@index([businessId, email])
  @@map("customers")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int           @map("duration_minutes")
  priceCents      Int?          @map("price_cents")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId, active])
  @@map("services")
}

model AvailabilityRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startTime  DateTime @map("start_time") @db.Time(0)
  endTime    DateTime @map("end_time") @db.Time(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek, startTime, endTime])
  @@index([businessId, dayOfWeek, active])
  @@map("availability_rules")
}

model Appointment {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId         String                        @map("business_id") @db.Uuid
  customerId         String                        @map("customer_id") @db.Uuid
  serviceId          String                        @map("service_id") @db.Uuid
  startsAt           DateTime                      @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime                      @map("ends_at") @db.Timestamptz(3)
  status             AppointmentStatus             @default(SCHEDULED)
  confirmationStatus AppointmentConfirmationStatus @default(PENDING) @map("confirmation_status")
  scheduleVersion    Int                           @default(1) @map("schedule_version")
  notes              String?
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  business           Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer                      @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  service            Service                       @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  events             AppointmentEvent[]
  riskScore          RiskScore?
  reminders          Reminder[]
  notifications      Notification[]
  publicActionLinks  AppointmentPublicActionLink[]

  @@unique([id, businessId])
  @@index([businessId, startsAt])
  @@index([businessId, status, startsAt])
  @@index([customerId, startsAt])
  @@map("appointments")
}

model AppointmentPublicActionLink {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String                  @map("business_id") @db.Uuid
  appointmentId   String                  @map("appointment_id") @db.Uuid
  action          AppointmentPublicAction
  recipient       String
  scheduleVersion Int                     @map("schedule_version")
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime?               @map("used_at") @db.Timestamptz(3)
  appointment     Appointment             @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([appointmentId, businessId, scheduleVersion, action, recipient], map: "appointment_public_action_links_scope_key")
  @@map("appointment_public_action_links")
}

model AppointmentEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String               @map("business_id") @db.Uuid
  appointmentId String               @map("appointment_id") @db.Uuid
  type          AppointmentEventType
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment          @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([appointmentId, createdAt])
  @@map("appointment_events")
}

model RiskScore {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String      @map("business_id") @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  score         Int
  level         RiskLevel
  factors       Json
  calculatedAt  DateTime    @default(now()) @map("calculated_at") @db.Timestamptz(3)
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([appointmentId, businessId])
  @@index([businessId, level])
  @@map("risk_scores")
}

model Reminder {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String                @map("business_id") @db.Uuid
  appointmentId       String                @map("appointment_id") @db.Uuid
  channel             ReminderChannel       @default(EMAIL)
  status              ReminderStatus        @default(PENDING)
  scheduledAt         DateTime              @map("scheduled_at") @db.Timestamptz(3)
  sentAt              DateTime?             @map("sent_at") @db.Timestamptz(3)
  providerId          String?               @map("provider_id")
  errorMessage        String?               @map("error_message")
  emailKind           AppointmentEmailKind? @map("email_kind")
  reminderOffsetHours Int?                  @map("reminder_offset_hours")
  deduplicationKey    String?               @unique @map("deduplication_key")
  scheduleVersion     Int?                  @map("schedule_version")
  recipient           String?
  emailData           Json?                 @map("email_data")
  attempts            Int                   @default(0)
  firstAttemptAt      DateTime?             @map("first_attempt_at") @db.Timestamptz(3)
  lastAttemptAt       DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  leaseUntil          DateTime?             @map("lease_until") @db.Timestamptz(3)
  payloadHash         String?               @map("payload_hash")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment         Appointment           @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, status, scheduledAt])
  @@index([appointmentId])
  @@index([status, scheduledAt])
  @@map("reminders")
}

model Notification {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String             @map("business_id") @db.Uuid
  appointmentId String?            @map("appointment_id") @db.Uuid
  kind          NotificationKind
  sourceKey     String             @map("source_key")
  startsAt      DateTime           @map("starts_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  reads         NotificationRead[]

  @@unique([businessId, sourceKey])
  @@unique([id, businessId])
  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_business_recent_idx")
  @@index([appointmentId])
  @@map("notifications")
}

model NotificationRead {
  businessId     String       @map("business_id") @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz(3)
  notification   Notification @relation(fields: [notificationId, businessId], references: [id, businessId], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId, businessId], references: [id, businessId], onDelete: Cascade)

  @@id([notificationId, profileId])
  @@index([businessId, profileId, notificationId], map: "notification_reads_profile_idx")
  @@index([profileId, businessId])
  @@map("notification_reads")
}
