# Copiar a apps/frontend/.env.local. Solo valores publicos: nada de service_role ni claves de Gemini.
# Mismos SUPABASE_URL y SUPABASE_ANON_KEY que apps/backend/.env
# En Vercel configurar ambos origenes HTTPS publicos, incluso el proveedor inactivo.
# NEXT_PUBLIC_* queda visible en el bundle: solo publishable o JWT anon, nunca secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_AZURE=false
NEXT_PUBLIC_API_URL_RENDER=https://turnosmart-backend-demo.onrender.com
NEXT_PUBLIC_API_URL_AZURE=https://turnosmart-api.azurewebsites.net
