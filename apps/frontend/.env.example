# Copiar a apps/frontend/.env.local. Solo valores publicos: nada de service_role ni claves de Gemini.
# Mismos SUPABASE_URL y SUPABASE_ANON_KEY que apps/backend/.env
# Solo desarrollo local. En Vercel usar las tres variables en Production, con URLs HTTPS publicas.
# NEXT_PUBLIC_* queda visible en el bundle: solo publishable o JWT anon, nunca secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
