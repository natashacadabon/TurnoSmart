{
  "name": "turnosmart",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS para gestion inteligente de turnos con prediccion de no-show.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=apps/frontend && npm run typecheck --workspace=apps/backend && npm run typecheck --workspace=packages/shared",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docker:dev": "docker compose -f infra/docker/compose.dev.yml up --build",
    "docker:down": "docker compose -f infra/docker/compose.dev.yml down",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.46.0"
  }
}
