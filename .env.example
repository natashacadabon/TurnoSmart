# General
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
PORT=4000
# Origenes permitidos para CORS, separados por coma.
CORS_ORIGIN=http://localhost:3000
# Supabase transaction pooler. Encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct connection or session pooler, used only by Prisma migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development seed: local or allowlisted Cloud project. Never commit a password.
# The existing admin password is never changed. See apps/backend/prisma/README.md.
SEED_ADMIN_PASSWORD=
# Optional preferred backend key (sb_secret_...). Falls back to SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Remote seed needs both gates plus the reviewed list in prisma/seed-targets.ts.
ALLOW_REMOTE_SEED=false
SEED_CONFIRM_REMOTE=

# AI (A08). Solo backend. Sin clave, la explicacion de riesgo responde 503 AI_UNAVAILABLE.
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_OUTPUT_TOKENS=400
# Limite de explicaciones por usuario por ventana.
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_WINDOW_MS=3600000

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=TurnoSmart <no-reply@turnosmart.local>

