# General
NODE_ENV=development

# Frontend
# next dev usa http://localhost:4000; no configurar una URL de API local aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
PORT=4000
# Origenes permitidos para CORS, separados por coma.
CORS_ORIGIN=http://localhost:3000
# Supabase transaction pooler. Encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct connection or session pooler, used only by Prisma migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Destinos cloud: URLs HTTPS canonicas, sin slash final, de dos proyectos distintos.
# Copiar tambien estas variables PUBLICAS a ambos servicios Render (no se heredan de GitHub).
EXPECTED_DEV_SUPABASE=
EXPECTED_PRODUCTION_SUPABASE=
# Fuera de Render, requerido para arrancar/migrar contra Cloud: preview (Dev) o production.
# En Render se deriva de RENDER_GIT_BRANCH: dev -> preview, main -> production.
# DEPLOY_TARGET=preview
# Conexiones remotas requieren sslmode=require (o verify-ca/verify-full).

# Opcional. Para emitir enlaces, configurar 32 bytes aleatorios en hexadecimal.
# APPOINTMENT_ACTION_SECRET=

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development seed: local or allowlisted Cloud project. Never commit a password.
# The existing admin password is never changed. See apps/backend/prisma/README.md.
SEED_ADMIN_PASSWORD=
# Optional preferred backend key (sb_secret_...). Falls back to SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Remote seed needs both gates plus the reviewed list in prisma/seed-targets.ts.
ALLOW_REMOTE_SEED=false
SEED_CONFIRM_REMOTE=

# AI (A08). Solo backend. Sin clave, la explicacion de riesgo responde 503 AI_UNAVAILABLE.
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
GEMINI_MAX_OUTPUT_TOKENS=400
# Limite de explicaciones por usuario por ventana.
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_WINDOW_MS=3600000
# Tope de llamadas a Gemini por instancia en la misma ventana y circuito ante fallas seguidas.
AI_GLOBAL_LIMIT_PER_WINDOW=200
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_COOLDOWN_MS=60000

# Observabilidad. Sin METRICS_TOKEN, /metrics responde 404 en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=
# SHA del build cuando el proveedor no lo informa (Render ya define RENDER_GIT_COMMIT).
RELEASE_SHA=

# Notificaciones por email. disabled conserva la cola; console simula envíos sin red.
# Usar console solo contra una base local: registra los trabajos simulados como enviados.
EMAIL_PROVIDER=disabled
# Con Resend o console, el envío se solicita después del commit de la reserva.
# El polling y EMAIL_CRON_SECRET permiten recuperación y recordatorios programados.
# Para Supabase Cron: 32 bytes aleatorios en hexadecimal, distintos de APPOINTMENT_ACTION_SECRET.
# Guardar el mismo valor en Vault como appointment_email_cron_secret.
# EMAIL_CRON_SECRET=
# Requerido con console o resend. Con Resend, usar un dominio verificado.
# EMAIL_FROM=TurnoSmart <turnos@example.com>
# Requerido con console o resend, junto con APPOINTMENT_ACTION_SECRET.
# Página receptora del fragmento #token=... (HTTPS con Resend).
# APPOINTMENT_ACTIONS_URL=https://turnos.example.com/turno/gestionar
# Ejemplo local con console o Resend en desarrollo: http://localhost:3000/turno/gestionar
# Requerido solo con resend. Desactivar el seguimiento de clics en su dominio.
# RESEND_API_KEY=
